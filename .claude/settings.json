{
  "permissions": {
    "allow": [
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-worktree-force.sh\""
          }
        ]
      }
    ]
  }
}
